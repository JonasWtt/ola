# Odysseus AI + vLLM Local Setup Configuration
# Copy this to .env and modify as needed

# ============================================
# Odysseus Settings
# ============================================

# Admin credentials (set these before first run!)
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=change-me-on-first-run

# App binding - for local use only
APP_BIND=127.0.0.1
APP_PORT=7000

# Authentication - disable for pure local comfort
AUTH_ENABLED=true
LOCALHOST_BYPASS=true  # Bypass auth for localhost requests
SECURE_COOKIES=false   # No HTTPS for local

# Data directories
APP_DATA_DIR=./data
APP_LOGS_DIR=./logs

# ============================================
# vLLM Connection
# ============================================
LLM_HOST=host.docker.internal
LLM_PORT=8000

# ============================================
# Model Backend (Optional - for API fallback)
# ============================================
OPENAI_API_KEY=
OLLAMA_BASE_URL=
RESEARCH_LLM_ENDPOINT=

# ============================================
# HuggingFace (Optional - for model downloads)
# ============================================
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# ============================================
# Vector Database
# ============================================
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# ============================================
# Search Engine
# ============================================
SEARXNG_INSTANCE=http://searxng:8080
SEARXNG_SECRET=
SEARXNG_BASE_URL=http://localhost:8080/

# ============================================
# Notifications
# ============================================
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://localhost:8091

# ============================================
# Performance Tuning
# ============================================

# Cleanup interval (hours)
CLEANUP_INTERVAL_HOURS=24

# In-process task limits (increase for better performance)
ODYSSEUS_INPROCESS_POLLERS=2
ODYSSEUS_INPROCESS_TASKS=4

# Upload limits (increase for local comfort)
ODYSSEUS_CHAT_UPLOAD_MAX_BYTES=52428800      # 50MB
ODYSSEUS_GALLERY_UPLOAD_MAX_BYTES=209715200  # 200MB
ODYSSEUS_GALLERY_TRANSFORM_UPLOAD_MAX_BYTES=52428800  # 50MB
ODYSSEUS_MEMORY_IMPORT_MAX_BYTES=52428800    # 50MB
ODYSSEUS_PERSONAL_UPLOAD_MAX_BYTES=52428800 # 50MB
ODYSSEUS_EMAIL_COMPOSE_UPLOAD_MAX_BYTES=52428800 # 50MB
ODYSSEUS_STT_MAX_AUDIO_BYTES=52428800        # 50MB
ODYSSEUS_ICS_MAX_BYTES=52428800              # 50MB

# ============================================
# Embeddings (Optional)
# ============================================
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FASTEMBED_CACHE_PATH=./data/fastembed

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite:///./data/app.db

# ============================================
# Docker GPU Overlay (Optional)
# ============================================
# Uncomment to enable NVIDIA GPU support in Odysseus container
# COMPOSE_FILE=docker-compose.odysseus.yml:docker/gpu.nvidia.yml

# ============================================
# User/Group IDs (for volume permissions)
# ============================================
PUID=1000
PGID=1000
